# 本地开发：复制本文件为 `.env.local` 并填入自己的值（所有 .env* 都已被 .gitignore 忽略）。

# 曲库 Worker 地址（可选，默认取 `config/index.js` 的 `music.workerUrl`）
# 本地联调 Cloudflare Worker 时设成 http://localhost:8787
NEXT_PUBLIC_MUSIC_WORKER_URL=

# R2 公开域名（可选，默认取 `config/index.js` 的 `music.r2BaseUrl`）
# 只有当 Worker 返回的是裸对象 key（不是绝对 URL）时才需要填
NEXT_PUBLIC_MUSIC_R2_BASE=
