{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "baseUrl": ".",
        "paths": {
            "components/*": [
                "components/*"
            ],
            "config": [
                "config/index.js"
            ],
            "utils/*": [
                "utils/*"
            ],
            "lib/*": [
                "lib/*"
            ],
            "styles/*": [
                "styles/*"
            ],
            "@/*": [
                "components/Music/pc/folia/src/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "pages/**/*.js"
    ],
    "exclude": [
        "node_modules",
        ".next",
        "out"
    ]
}
